<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.goaerion.testcode.http.quant.storage.TdFetchLogMapper">

    <!-- 按任务类型倒序查询最近 N 条拉取日志，命中索引 idx_fetch_log_type_time -->
    <select id="selectRecentLogs" resultType="com.goaerion.testcode.http.quant.entity.TdFetchLog">
        SELECT id,
               task_type,
               symbol,
               "interval",
               bars_fetched,
               status,
               error_msg,
               credits_cost,
               started_at,
               finished_at
        FROM td_fetch_log
        <where>
            <if test="taskType != null and taskType != ''">
                task_type = #{taskType}
            </if>
        </where>
        ORDER BY started_at DESC
        LIMIT #{limit}
    </select>

</mapper>